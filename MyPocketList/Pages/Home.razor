@using MyPocketList.Pages.Components
@using MyPocketList.Service
@inject IInfoService infoService
@page "/"

<PageTitle>My Pocket List</PageTitle>

<h1>My Pocket List</h1>

<FluentTabs>
    <FluentTab Label="Lists">
        <p>Manage your lists</p>
    </FluentTab>
    <FluentTab Label="Shop">
        <p>Manage your shopping items.</p>
        <ListsComponent />
    </FluentTab>
    <FluentTab Label="Basket">
        <p>View your shopped items</p>
    </FluentTab>
</FluentTabs>

<FluentButton Appearance="Appearance.Accent" @onclick="ShowTestAlert">
    Show alert
</FluentButton>
<FluentSpacer/>
<FluentButton Appearance="Appearance.Accent" @onclick="ShowConfirmation">
    Test confirmation
</FluentButton>

@code {

    private async void ShowTestAlert()
    {
        await infoService.Alert("This is some kind of test that I hope is working for me today.");
    }

    private async void ShowConfirmation() {
        var res=await infoService.Confirm("Do you want to do this?");
        if (res) {
            await infoService.Alert("You pressed Ok");
        }
        else {
            await infoService.Alert("Why did you cancel?");
        }
    }
}