@using MyPocketList.Core.Models
@using MyPocketList.Core.Services
@using MyPocketList.Services
@inject IShoppingListService listService
@inject IShoppingService shoppingService
@inject IInfoService infoService
@page "/"

<PageTitle>My Pocket List</PageTitle>

<h1>My Pocket List</h1>

<FluentTabs>
    <FluentTab Id="lists-tab" Label="Lists">
        <ListsComponent ActiveList="_activeList" OnListDeleted="HandleListDeleted" OnListsChanged="HandleListsChanged" />
    </FluentTab>
    <FluentTab Id="shop-tab" Label="Shop">
        <ShopComponent SelectedList="_activeList" OnListSelected="HandleListSelected" OnDataChanged="HandleDataChanged" />
    </FluentTab>
    <FluentTab Id="basket-tab" Label="Basket">
        <BasketComponent ActiveList="_activeList" OnDataChanged="HandleDataChanged" />
    </FluentTab>
</FluentTabs>

@code {

    private ShoppingList? _activeList;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await listService.InitializeAsync();
        }
        catch (Exception ex)
        {
            await infoService.Alert($"Could not load your lists: {ex.Message}");
        }

        _activeList = listService.Lists.FirstOrDefault();
        if (_activeList != null)
        {
            shoppingService.SetShoppingList(_activeList);
        }
    }

    private void HandleListSelected(ShoppingList list)
    {
        _activeList = list;
        shoppingService.SetShoppingList(list);
    }

    private void HandleListDeleted(Guid id)
    {
        if (_activeList?.Id == id)
        {
            _activeList = null;
        }
    }

    private void HandleListsChanged() => StateHasChanged();

    private void HandleDataChanged() => StateHasChanged();
}
