@using MyPocketList.Pages.Components
@inject IDialogService DialogService
@page "/"

<PageTitle>My Pocket List</PageTitle>

<h1>My Pocket List</h1>

<FluentTabs>
    <FluentTab Label="Lists">
        <p>Manage your lists</p>
    </FluentTab>
    <FluentTab Label="Shop">
        <p>Manage your shopping items.</p>
        <ListsComponent />
    </FluentTab>
    <FluentTab Label="Basket">
        <p>View your shopped items</p>
    </FluentTab>
</FluentTabs>

@code {
        protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ShowDialog();
        }
    }
    
    private async Task ShowDialog()
    {
        var dialogParams = new DialogParameters
        {
            Title = "This is some kind of test."
        };
        await DialogService.ShowDialogAsync<Dialog>(dialogParams);
    }
}