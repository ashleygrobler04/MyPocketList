@implements IDialogContentComponent

<h3>Hello</h3>

<p>Hello from the dialog!</p>

<FluentButton Appearance="Appearance.Accent"
              @onclick="Close">
    OK
</FluentButton>

@code {
    [CascadingParameter]
    public FluentDialog dlg{ get; set; } = default!;

    private async Task Close()
    {
        await dlg.CloseAsync();
    }
}